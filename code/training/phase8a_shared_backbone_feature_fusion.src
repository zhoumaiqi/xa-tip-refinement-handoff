from __future__ import annotations
import argparse, hashlib, importlib.util, json, math, os, random, shutil, time
from pathlib import Path
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader, Subset
from tqdm import tqdm
import matplotlib.pyplot as plt

ROOT=Path(__file__).resolve().parents[1]

def load_pyc(name, path):
    spec=importlib.util.spec_from_file_location(name,path)
    mod=importlib.util.module_from_spec(spec); spec.loader.exec_module(mod); return mod

class Logger:
    def __init__(self,path): self.path=path; path.parent.mkdir(parents=True,exist_ok=True)
    def __call__(self,msg):
        print(msg,flush=True)
        with self.path.open('a',encoding='utf-8') as f: f.write(str(msg)+'\n')

def seed_all(seed):
    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed); torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic=True; torch.backends.cudnn.benchmark=False
    try: torch.use_deterministic_algorithms(True,warn_only=True)
    except Exception: pass

class FusionDataset(Dataset):
    def __init__(self,base,arm): self.base=base; self.arm=arm; self.w=base.w
    def __len__(self): return len(self.base)
    def __getitem__(self,i):
        x=np.asarray(self.base.x[i],dtype=np.float32)
        if self.arm=='D': gray=np.repeat(x[2:3],3,axis=0)
        else: gray=x
        rgb=np.repeat(gray[:,None,:,:],3,axis=1)
        return torch.from_numpy(rgb.copy()),torch.from_numpy(self.base.y[i]),int(i)

class SharedBackboneFusion(nn.Module):
    def __init__(self,p5):
        super().__init__()
        base=p5.HRNetTipHeatmap('hrnet_w18_small_v2',True,1,(64,64))
        self.backbone=base.backbone
        self.fusion=nn.Conv2d(54,18,kernel_size=1)
        self.relu=nn.ReLU(inplace=False)
        self.heatmap_head=base.heatmap_head
        self.feature_shape=None; self.concat_shape=None; self.fused_shape=None
    def extract(self,x):
        b=self.backbone
        z=b.act1(b.bn1(b.conv1(x))); z=b.act2(b.bn2(b.conv2(z)))
        return b.stages(z)[0]
    def forward(self,x):
        B,T,C,H,W=x.shape
        f=self.extract(x.reshape(B*T,C,H,W))
        _,FC,FH,FW=f.shape
        f=f.reshape(B,T,FC,FH,FW)
        cat=f.reshape(B,T*FC,FH,FW)
        fused=self.relu(self.fusion(cat)); out=self.heatmap_head(fused)
        self.feature_shape=tuple(f.shape); self.concat_shape=tuple(cat.shape); self.fused_shape=tuple(fused.shape)
        if tuple(out.shape[1:])!=(1,64,64): raise RuntimeError(f'Output shape mismatch: {tuple(out.shape)}')
        return out

def weighted_mse(pred,target): return ((1.0+9.0*target)*(pred-target).square()).mean()

def tensor_hash(model):
    h=hashlib.sha256()
    for k,v in model.state_dict().items(): h.update(k.encode()); h.update(v.detach().cpu().numpy().tobytes())
    return h.hexdigest()

def params(model):
    return {
      'backbone':sum(p.numel() for p in model.backbone.parameters()),
      'fusion':sum(p.numel() for p in model.fusion.parameters()),
      'head':sum(p.numel() for p in model.heatmap_head.parameters()),
      'total':sum(p.numel() for p in model.parameters())}

def memory_sanity(p5,ds,device,cfg,out,log):
    result={'device':torch.cuda.get_device_name(0),'amp':False,'attempts':[]}
    chosen=None
    for bsz in cfg['physical_batch_candidates']:
        try:
            torch.cuda.empty_cache(); torch.cuda.reset_peak_memory_stats(); seed_all(cfg['stage1_seed'])
            m=SharedBackboneFusion(p5).to(device); opt=torch.optim.Adam(m.parameters(),lr=cfg['learning_rate'])
            x,y,_=next(iter(DataLoader(Subset(ds,np.arange(min(bsz,len(ds)))),batch_size=bsz)))
            x=x.to(device); y=y.to(device); opt.zero_grad(set_to_none=True); pred=m(x); loss=weighted_mse(pred,y); loss.backward()
            grads={n:bool(p.grad is not None and torch.isfinite(p.grad).all()) for n,p in [('backbone',next(m.backbone.parameters())),('fusion',m.fusion.weight),('head',m.heatmap_head.weight)]}
            peak=int(torch.cuda.max_memory_allocated()); ok=all(grads.values()) and bool(torch.isfinite(loss).item())
            result['attempts'].append({'physical_batch':bsz,'status':'PASS' if ok else 'FAIL','peak_memory_bytes':peak,'loss':float(loss),'gradients_finite':grads})
            if ok:
                m.eval(); torch.cuda.synchronize(); t0=time.perf_counter()
                with torch.no_grad():
                    for _ in range(10): _=m(x)
                torch.cuda.synchronize(); ms=(time.perf_counter()-t0)*1000.0/(10*len(x))
                chosen=bsz; result.update({'physical_batch':bsz,'gradient_accumulation':cfg['effective_batch_size']//bsz,'effective_batch':cfg['effective_batch_size'],'input_shape':list(x.shape),'shared_feature_shape':list(m.feature_shape),'concatenated_shape':list(m.concat_shape),'fused_shape':list(m.fused_shape),'output_shape':list(pred.shape),'inference_ms_per_window':ms}); del m,opt,x,y,pred,loss; torch.cuda.empty_cache(); break
        except torch.cuda.OutOfMemoryError as e:
            result['attempts'].append({'physical_batch':bsz,'status':'OOM','error':str(e)}); torch.cuda.empty_cache()
    if chosen is None: raise RuntimeError('No physical batch in {16,8,4} passed memory sanity')
    if cfg['effective_batch_size']%chosen: raise RuntimeError('Effective batch is not divisible by physical batch')
    (out/'memory_sanity.json').write_text(json.dumps(result,indent=2),encoding='utf-8')
    log(f"[Memory] physical={chosen}, accumulation={result['gradient_accumulation']}, effective=16, peak={result['attempts'][-1].get('peak_memory_bytes',0)/2**30:.2f} GiB")
    return chosen,result['gradient_accumulation']

def audit_model(p5,out,cfg,device):
    seed_all(cfg['stage1_seed']); m=SharedBackboneFusion(p5).to(device); pc=params(m)
    p6_total=3860739
    pd.DataFrame([{'model':'Phase6G single HRNet','backbone':3860720,'fusion':0,'head':19,'total':p6_total},
                  {'model':'Phase7B channel stack','backbone':3860720,'fusion':0,'head':19,'total':p6_total},
                  {'model':'Phase8A shared feature fusion',**pc}]).to_csv(out/'parameter_count.csv',index=False)
    ids=[id(m.backbone) for _ in range(3)]
    text=f"ONE shared backbone verified: {len(set(ids))==1}\nBackbone object IDs for t-2,t-1,t references: {ids}\nNo backbone_t2/backbone_t1/backbone_t attributes: {not any(hasattr(m,x) for x in ['backbone_t2','backbone_t1','backbone_t'])}\nState dict backbone key count: {sum(k.startswith('backbone.') for k in m.state_dict())}\nFeature extraction point: backbone.stages output branch[0]\nFeature tensor: [B,18,64,64]\nFusion: concat [B,54,64,64] -> Conv1x1(54,18) -> ReLU\n"
    (out/'weight_sharing_audit.txt').write_text(text,encoding='utf-8'); return pc

def audit_paired_initialization(out):
    rows=[]
    for dmeta in out.rglob('arm_D/complete.json'):
        emeta=dmeta.parent.parent/'arm_E'/'complete.json'
        if not emeta.exists(): continue
        d=json.loads(dmeta.read_text(encoding='utf-8')); e=json.loads(emeta.read_text(encoding='utf-8'))
        rows.append({'run_group':str(dmeta.parent.parent.relative_to(out)),'D_initial_state_hash':d.get('initial_state_hash'),'E_initial_state_hash':e.get('initial_state_hash'),'same':d.get('initial_state_hash')==e.get('initial_state_hash')})
    frame=pd.DataFrame(rows); frame.to_csv(out/'paired_initialization_audit.csv',index=False)
    if len(frame) and not bool(frame.same.all()): raise RuntimeError('Paired ARM D/E initialization hash mismatch; stopping before interpretation')
    return frame

def train_one(p5,ds,indices,arm,base_seed,fold,physical,accum,device,run_dir,cfg,log):
    run_dir.mkdir(parents=True,exist_ok=True); done=run_dir/'complete.json'; predp=run_dir/'predictions.csv'; ckpt=run_dir/'checkpoint.pth'; tlp=run_dir/'training_log.csv'
    run_hash=hashlib.sha256(json.dumps({'cfg':cfg,'arm':arm,'seed':base_seed,'fold':fold,'indices':len(indices)},sort_keys=True).encode()).hexdigest()
    if done.exists() and predp.exists() and ckpt.exists() and tlp.exists():
        meta=json.loads(done.read_text(encoding='utf-8'))
        if meta.get('run_hash')==run_hash: log(f'  [Resume] seed={base_seed} fold={fold} arm={arm}'); return pd.read_csv(predp),pd.read_csv(tlp)
    eff=base_seed+fold if fold>0 else base_seed; seed_all(eff); model=SharedBackboneFusion(p5).to(device); init_hash=tensor_hash(model)
    gen=torch.Generator().manual_seed(eff); loader=DataLoader(Subset(ds,indices),batch_size=physical,shuffle=True,num_workers=0,pin_memory=True,generator=gen)
    opt=torch.optim.Adam(model.parameters(),lr=cfg['learning_rate'],weight_decay=cfg['weight_decay']); sch=torch.optim.lr_scheduler.MultiStepLR(opt,milestones=cfg['scheduler_milestones'],gamma=cfg['scheduler_gamma'])
    logs=[]
    for epoch in range(1,cfg['epochs']+1):
        model.train(); opt.zero_grad(set_to_none=True); total=0.; n=0
        bar=tqdm(loader,desc=f'{arm} seed={base_seed} fold={fold} epoch {epoch}/3',leave=False)
        for bi,(x,y,_) in enumerate(bar):
            x=x.to(device,non_blocking=True); y=y.to(device,non_blocking=True); pred=model(x); loss=weighted_mse(pred,y); (loss/accum).backward(); total+=float(loss)*len(x); n+=len(x)
            if (bi+1)%accum==0 or bi+1==len(loader): opt.step(); opt.zero_grad(set_to_none=True)
            bar.set_postfix(loss=f'{total/n:.6f}')
        sch.step(); logs.append({'epoch':epoch,'train_loss':total/n,'learning_rate':opt.param_groups[0]['lr'],'arm':arm,'base_seed':base_seed,'fold':fold})
        log(f'  {arm} seed={base_seed} fold={fold} epoch {epoch}/3 loss={total/n:.6f}')
    torch.save({'model_state':model.state_dict(),'arm':arm,'base_seed':base_seed,'effective_seed':eff,'fold':fold,'config':cfg},ckpt)
    preds=infer(model,ds,np.setdiff1d(np.arange(len(ds)),indices) if fold>0 else np.arange(0),device,cfg['alpha'],physical)
    # fold evaluation indices are replaced by caller immediately below when needed
    pd.DataFrame(logs).to_csv(tlp,index=False)
    return model,pd.DataFrame(logs),init_hash,run_hash

def infer(model,ds,indices,device,alpha,batch):
    model.eval(); rows=[]; loader=DataLoader(Subset(ds,indices),batch_size=max(batch,8),shuffle=False,num_workers=0,pin_memory=True)
    with torch.no_grad():
        for x,_,ids in tqdm(loader,desc='Inference',leave=False):
            hm=model(x.to(device,non_blocking=True)).detach().cpu().numpy()[:,0]
            for h,ii in zip(hm,ids.numpy()):
                r=ds.w.iloc[int(ii)]; flat=int(np.argmax(h)); hy,hx=np.unravel_index(flat,h.shape); pk=float(h[hy,hx]); tmp=h.copy(); rad=6; tmp[max(0,hy-rad):min(64,hy+rad+1),max(0,hx-rad):min(64,hx+rad+1)]=-np.inf; sec=float(np.max(tmp)); mar=pk-sec
                cx=float(r.crop_x0)+4.0*hx; cy=float(r.crop_y0)+4.0*hy; fx=float(r.raw_x)+alpha*(cx-float(r.raw_x)); fy=float(r.raw_y)+alpha*(cy-float(r.raw_y))
                rawerr=math.hypot(float(r.raw_x)-float(r.gt_x),float(r.raw_y)-float(r.gt_y)); ce=math.hypot(cx-float(r.gt_x),cy-float(r.gt_y)); fe=math.hypot(fx-float(r.gt_x),fy-float(r.gt_y))
                rows.append({'case_id':str(r.case_id),'series_id':str(r.series_id),'sequence_identifier':str(r.sequence_identifier),'frame_index':int(r.frame_index),'dicom_path':str(r.path_t),'raw_x':r.raw_x,'raw_y':r.raw_y,'gt_x':r.gt_x,'gt_y':r.gt_y,'crop_x0':r.crop_x0,'crop_y0':r.crop_y0,'candidate_x':cx,'candidate_y':cy,'final_x':fx,'final_y':fy,'raw_error_px':rawerr,'candidate_error_px':ce,'final_error_px':fe,'gain_px':rawerr-fe,'peak':pk,'second_peak':sec,'margin':mar,'pred_x_heatmap':hx,'pred_y_heatmap':hy})
    return pd.DataFrame(rows)

def run_model(p5,ds,train_idx,eval_idx,arm,seed,fold,physical,accum,device,run_dir,cfg,log):
    run_dir.mkdir(parents=True,exist_ok=True)
    done=run_dir/'complete.json'; predp=run_dir/'predictions.csv'; tlp=run_dir/'training_log.csv'; ckpt=run_dir/'checkpoint.pth'
    rh=hashlib.sha256(json.dumps({'cfg':cfg,'arm':arm,'seed':seed,'fold':fold,'train_n':len(train_idx),'eval_n':len(eval_idx)},sort_keys=True).encode()).hexdigest()
    if done.exists() and predp.exists() and tlp.exists() and ckpt.exists() and json.loads(done.read_text()).get('run_hash')==rh:
        log(f'  [Resume] seed={seed} fold={fold} arm={arm}'); return pd.read_csv(predp),pd.read_csv(tlp)
    eff=seed+fold if fold else seed; seed_all(eff); model=SharedBackboneFusion(p5).to(device); init_hash=tensor_hash(model)
    gen=torch.Generator().manual_seed(eff); loader=DataLoader(Subset(ds,train_idx),batch_size=physical,shuffle=True,num_workers=0,pin_memory=True,generator=gen)
    opt=torch.optim.Adam(model.parameters(),lr=cfg['learning_rate'],weight_decay=0); sch=torch.optim.lr_scheduler.MultiStepLR(opt,milestones=cfg['scheduler_milestones'],gamma=cfg['scheduler_gamma']); logs=[]
    for ep in range(1,4):
        model.train(); opt.zero_grad(set_to_none=True); total=0.; n=0
        bar=tqdm(loader,desc=f'{arm} seed={seed} fold={fold} epoch {ep}/3',leave=False)
        for bi,(x,y,_) in enumerate(bar):
            x=x.to(device,non_blocking=True); y=y.to(device,non_blocking=True); o=model(x); loss=weighted_mse(o,y); (loss/accum).backward(); total+=float(loss)*len(x); n+=len(x)
            if (bi+1)%accum==0 or bi+1==len(loader): opt.step(); opt.zero_grad(set_to_none=True)
            bar.set_postfix(loss=f'{total/n:.6f}')
        sch.step(); logs.append({'epoch':ep,'train_loss':total/n,'learning_rate':opt.param_groups[0]['lr'],'arm':arm,'base_seed':seed,'fold':fold}); log(f'  {arm} seed={seed} fold={fold} epoch {ep}/3 loss={total/n:.6f}')
    pred=infer(model,ds,eval_idx,device,cfg['alpha'],physical); pred.to_csv(predp,index=False); pd.DataFrame(logs).to_csv(tlp,index=False)
    torch.save({'model_state':model.state_dict(),'arm':arm,'base_seed':seed,'effective_seed':eff,'fold':fold,'config':cfg},ckpt)
    done.write_text(json.dumps({'complete':True,'run_hash':rh,'arm':arm,'base_seed':seed,'effective_seed':eff,'fold':fold,'train_n':len(train_idx),'eval_n':len(eval_idx),'initial_state_hash':init_hash,'finished_at':time.strftime('%Y-%m-%d %H:%M:%S')},indent=2),encoding='utf-8')
    del model,opt,loader; torch.cuda.empty_cache(); return pred,pd.DataFrame(logs)

def metric(e,raw):
    e=np.asarray(e,float); raw=np.asarray(raw,float); gain=raw-e
    return {'n':len(e),'mean':e.mean(),'median':np.median(e),'p95':np.percentile(e,95),'p99':np.percentile(e,99),'max':e.max(),'lt5':np.mean(e<5),'lt10':np.mean(e<10),'lt20':np.mean(e<20),'lt40':np.mean(e<40),'mean_gain':gain.mean(),'median_gain':np.median(gain),'improved':np.mean(gain>0),'harmful_gt5':np.mean(gain<-5),'harmful_gt10':np.mean(gain<-10),'harmful_gt20':np.mean(gain<-20)}

def persistent(df,arm,seed,split):
    seg=[]; total=0
    for _,g in df.sort_values(['case_id','series_id','frame_index']).groupby(['case_id','series_id']):
        bad=g.gain_px.to_numpy(float)<-10; total+=int(bad.sum()); run=0
        for b in bad:
            if b: run+=1
            elif run: seg.append(run); run=0
        if run: seg.append(run)
    return {'split':split,'base_seed':seed,'arm':arm,'total_harmful_frames':total,'persistent_frames_ge3':sum(x for x in seg if x>=3),'segments_ge3':sum(x>=3 for x in seg),'segments_ge5':sum(x>=5 for x in seg),'segments_ge10':sum(x>=10 for x in seg),'max_segment':max(seg,default=0)}

def analyze_pair(D,E,seed,split):
    rows=[]
    for arm,g in [('D',D),('E',E)]:
        for alpha,col in [(1.0,'candidate_error_px'),(.75,'final_error_px')]:
            q=metric(g[col],g.raw_error_px); q.update(split=split,base_seed=seed,arm=arm,alpha=alpha,case_macro_mean=g.groupby('case_id')[col].mean().mean()); rows.append(q)
    by=[]
    for case in sorted(D.case_id.astype(str).unique()):
        for arm,g in [('D',D),('E',E)]:
            x=g[g.case_id.astype(str).eq(case)]; by.append({'base_seed':seed,'case_id':case,'arm':arm,'mean':x.final_error_px.mean(),'median':x.final_error_px.median(),'p95':np.percentile(x.final_error_px,95)})
    return pd.DataFrame(rows),pd.DataFrame(by),pd.DataFrame([persistent(D,'D',seed,split),persistent(E,'E',seed,split)])

def safety_hard(df,arm,seed,split):
    safe=[]; hard=[]
    for hi,label in [(5,'raw_lt5'),(10,'raw_lt10')]:
        g=df[df.raw_error_px<hi]; gain=g.gain_px
        safe.append({'split':split,'base_seed':seed,'arm':arm,'bin':label,'n':len(g),'mean':g.final_error_px.mean(),'median':g.final_error_px.median(),'harmful_gt5':np.mean(gain<-5),'harmful_gt10':np.mean(gain<-10)})
    for lo,hi in [(20,40),(40,60)]:
        g=df[(df.raw_error_px>=lo)&(df.raw_error_px<hi)]
        hard.append({'split':split,'base_seed':seed,'arm':arm,'bin':f'raw_{lo}_{hi}','n':len(g),'mean_error':g.final_error_px.mean(),'mean_gain':g.gain_px.mean(),'median_gain':g.gain_px.median(),'improved':np.mean(g.gain_px>0)})
    return safe,hard

def stage1(p5,dsets,cases,physical,accum,device,out,cfg,log):
    sdir=out/'stage1'; sdir.mkdir(parents=True,exist_ok=True); seed=cfg['stage1_seed']; parts={'D':[],'E':[]}; logs=[]
    log('[STAGE 1] 1 seed, 8-fold OOF, D vs E; Val forbidden')
    for fold,held in enumerate(cases,1):
        log(f'[Stage1 {fold}/8] held case={held}')
        for arm in ['D','E']:
            ds=dsets[arm]; train=np.where(ds.w.case_id.astype(str).ne(held))[0]; ev=np.where(ds.w.case_id.astype(str).eq(held))[0]
            p,t=run_model(p5,ds,train,ev,arm,seed,fold,physical,accum,device,sdir/f'runs/fold_{fold}_{held}/arm_{arm}',cfg,log); p['base_seed']=seed; p['fold']=fold; p['arm']=arm; parts[arm].append(p); logs.append(t)
    D=pd.concat(parts['D'],ignore_index=True); E=pd.concat(parts['E'],ignore_index=True)
    D.to_csv(sdir/'stage1_oof_D_predictions.csv',index=False); E.to_csv(sdir/'stage1_oof_E_predictions.csv',index=False)
    met,by,pers=analyze_pair(D,E,seed,'OOF'); met.to_csv(sdir/'stage1_metrics.csv',index=False); by.to_csv(sdir/'stage1_by_case.csv',index=False); pers.to_csv(sdir/'stage1_persistent_harmful.csv',index=False)
    piv=by.pivot(index='case_id',columns='arm',values='mean'); piv['delta_E_minus_D']=piv.E-piv.D
    Dm=met[(met.arm=='D')&(met.alpha==.75)].iloc[0]; Em=met[(met.arm=='E')&(met.alpha==.75)].iloc[0]
    wins=int((piv.delta_E_minus_D < -cfg['stage1_tie_px']).sum()); ties=int((piv.delta_E_minus_D.abs()<=cfg['stage1_tie_px']).sum()); losses=8-wins-ties
    harm_ok=float(Em.harmful_gt10)<=float(Dm.harmful_gt10)+cfg['stage1_max_harmful_gt10_increase_abs']
    passed=bool(Em.case_macro_mean<Dm.case_macro_mean and wins+ties>=5 and harm_ok and np.isfinite(met.select_dtypes('number')).all().all())
    decision={'stage1_pass':passed,'D_case_macro_mean':float(Dm.case_macro_mean),'E_case_macro_mean':float(Em.case_macro_mean),'delta_E_minus_D':float(Em.case_macro_mean-Dm.case_macro_mean),'wins':wins,'ties':ties,'losses':losses,'noninferior_cases':wins+ties,'D_harmful_gt10':float(Dm.harmful_gt10),'E_harmful_gt10':float(Em.harmful_gt10),'harmful_gate_limit_abs_increase':cfg['stage1_max_harmful_gt10_increase_abs'],'harmful_gate_pass':bool(harm_ok),'val_read':False,'test_used':False}
    (sdir/'stage1_decision.json').write_text(json.dumps(decision,indent=2),encoding='utf-8')
    piv[['D','E']].plot(kind='bar',figsize=(9,4)); plt.ylabel('Mean error (px)'); plt.title('Stage1 OOF by held-out case'); plt.tight_layout(); (out/'figures').mkdir(exist_ok=True); plt.savefig(out/'figures/stage1_case_comparison.png',dpi=180); plt.close()
    log(f"[Stage1 Decision] {'PASS' if passed else 'FAIL'} | D={Dm.case_macro_mean:.3f}, E={Em.case_macro_mean:.3f}, wins/ties/losses={wins}/{ties}/{losses}, harmful>10={Dm.harmful_gt10:.3%}->{Em.harmful_gt10:.3%}")
    return passed,D,E,met,by,pers

def savefig(path): plt.tight_layout(); plt.savefig(path,dpi=180,bbox_inches='tight'); plt.close()

def plot_stage2(out,metrics,by,delta,valdelta,pers,safe,hard):
    fig=out/'figures'; fig.mkdir(exist_ok=True)
    plt.axhline(0,color='black',lw=.8); plt.plot(delta.base_seed.astype(str),delta.delta_E_minus_D,marker='o'); plt.ylabel('E - D case-macro mean (px)'); plt.title('OOF feature-fusion temporal delta'); savefig(fig/'oof_delta_by_seed.png')
    mat=by.pivot_table(index='case_id',columns='base_seed',values='delta_E_minus_D'); lim=np.nanmax(np.abs(mat.to_numpy())); plt.figure(figsize=(8,5)); im=plt.imshow(mat,aspect='auto',cmap='coolwarm',vmin=-lim,vmax=lim); plt.colorbar(im,label='E - D (px)'); plt.xticks(range(len(mat.columns)),mat.columns,rotation=30); plt.yticks(range(len(mat.index)),mat.index); plt.title('Case × seed feature-fusion delta'); savefig(fig/'case_seed_heatmap.png')
    plt.axhline(0,color='black',lw=.8); plt.plot(valdelta.base_seed.astype(str),valdelta.delta_E_minus_D,marker='o'); plt.ylabel('Val E - D mean (px)'); plt.title('Val feature-fusion temporal delta'); savefig(fig/'val_delta_by_seed.png')
    plt.axhline(0,color='black',lw=.8); plt.axvline(0,color='black',lw=.8); plt.scatter(delta.delta_E_minus_D,valdelta.delta_E_minus_D); [plt.text(r.delta_E_minus_D,v.delta_E_minus_D,str(int(r.base_seed)),fontsize=8) for r,v in zip(delta.itertuples(),valdelta.itertuples())]; plt.xlabel('OOF E-D'); plt.ylabel('Val E-D'); plt.title('OOF vs Val direction'); savefig(fig/'oof_vs_val_direction.png')
    for frame,col,name in [(safe[safe.split=='OOF'],'harmful_gt10','easy_case_safety.png'),(hard[hard.split=='OOF'],'mean_gain','hard_case_rescue.png'),(pers[pers.split=='OOF'],'persistent_frames_ge3','persistent_harmful.png')]:
        frame.pivot_table(index='base_seed',columns='arm',values=col,aggfunc='mean').plot(marker='o'); plt.ylabel(col); plt.title(name.replace('_',' ').replace('.png','')); savefig(fig/name)

def montage(out,dsE,E,p7d_root):
    # Base seed comparison, using cached normalized crops only. Failures in optional visualization never invalidate metrics.
    try:
        old=[]
        for p in sorted((p7d_root/'oof/seed_20260918').rglob('arm_C/predictions.csv')): old.append(pd.read_csv(p))
        old=pd.concat(old,ignore_index=True); keys=['case_id','series_id','frame_index']; old.case_id=old.case_id.astype(str); old.series_id=old.series_id.astype(str); E=E.copy(); E.case_id=E.case_id.astype(str); E.series_id=E.series_id.astype(str)
        q=E.merge(old[keys+['final_x','final_y','final_error_px']],on=keys,suffixes=('_E','_stack')); q['rescue']=q.final_error_px_stack-q.final_error_px_E
        for mode,sel,name in [('rescue',q.nlargest(8,'rescue'),'feature_fusion_rescue_examples.png'),('failure',q.nsmallest(8,'rescue'),'feature_fusion_failure_examples.png')]:
            fig,axs=plt.subplots(len(sel),3,figsize=(8,2.3*len(sel)))
            for rr,(idx,row) in enumerate(sel.iterrows()):
                wi=int(dsE.w.index[(dsE.w.case_id.astype(str)==str(row.case_id))&(dsE.w.series_id.astype(str)==str(row.series_id))&(dsE.w.frame_index.astype(int)==int(row.frame_index))][0]); stack=np.asarray(dsE.base.x[wi]); meta=dsE.w.iloc[wi]
                for t in range(3):
                    ax=axs[rr,t]; ax.imshow(stack[t],cmap='gray',vmin=0,vmax=1); ax.axis('off'); ax.set_title(['t-2','t-1','t'][t],fontsize=8)
                    if t==2:
                        ax.scatter([meta.gt_x-meta.crop_x0],[meta.gt_y-meta.crop_y0],c='r',s=12,label='GT'); ax.scatter([row.final_x_E-meta.crop_x0],[row.final_y_E-meta.crop_y0],c='lime',s=12,label='Fusion'); ax.scatter([row.final_x_stack-meta.crop_x0],[row.final_y_stack-meta.crop_y0],c='cyan',s=12,label='Stack'); ax.legend(fontsize=5,loc='lower right')
            savefig(out/'figures'/name)
    except Exception as e:
        (out/'visualization_warning.txt').write_text(str(e),encoding='utf-8')

def stage2(p5,dsets,cases,physical,accum,device,out,cfg,log,stage1_data):
    sdir=out/'stage2'; sdir.mkdir(parents=True,exist_ok=True); allpred={'D':[],'E':[]}; mets=[]; bys=[]; pers=[]; saf=[]; hard=[]
    D1,E1,*_=stage1_data
    for arm,x in [('D',D1),('E',E1)]: x=x.copy(); x['base_seed']=cfg['stage1_seed']; allpred[arm].append(x)
    m,b,p=analyze_pair(D1,E1,cfg['stage1_seed'],'OOF'); mets.append(m); bys.append(b); pers.append(p)
    for arm,x in [('D',D1),('E',E1)]: s,h=safety_hard(x,arm,cfg['stage1_seed'],'OOF'); saf+=s; hard+=h
    for seed in cfg['seeds'][1:]:
        parts={'D':[],'E':[]}
        for fold,held in enumerate(cases,1):
            log(f'[Stage2 OOF] seed={seed} fold={fold}/8 held={held}')
            for arm in ['D','E']:
                ds=dsets[arm]; tr=np.where(ds.w.case_id.astype(str).ne(held))[0]; ev=np.where(ds.w.case_id.astype(str).eq(held))[0]
                x,_=run_model(p5,ds,tr,ev,arm,seed,fold,physical,accum,device,sdir/f'runs/oof/seed_{seed}/fold_{fold}_{held}/arm_{arm}',cfg,log); x['base_seed']=seed; x['fold']=fold; x['arm']=arm; parts[arm].append(x)
        D=pd.concat(parts['D'],ignore_index=True); E=pd.concat(parts['E'],ignore_index=True); allpred['D'].append(D); allpred['E'].append(E); m,b,p=analyze_pair(D,E,seed,'OOF'); mets.append(m); bys.append(b); pers.append(p)
        for arm,x in [('D',D),('E',E)]: s,h=safety_hard(x,arm,seed,'OOF'); saf+=s; hard+=h
    OD=pd.concat(allpred['D'],ignore_index=True); OE=pd.concat(allpred['E'],ignore_index=True); OD.to_csv(sdir/'oof_D_all_seeds.csv',index=False); OE.to_csv(sdir/'oof_E_all_seeds.csv',index=False)
    metrics=pd.concat(mets,ignore_index=True); by=pd.concat(bys,ignore_index=True); pers=pd.concat(pers,ignore_index=True); safe=pd.DataFrame(saf); hard=pd.DataFrame(hard)
    metrics.to_csv(sdir/'oof_metrics_by_seed.csv',index=False); by.to_csv(sdir/'oof_metrics_by_case_seed.csv',index=False); safe.to_csv(sdir/'easy_case_safety.csv',index=False); hard.to_csv(sdir/'hard_case_rescue.csv',index=False); pers.to_csv(sdir/'persistent_harmful.csv',index=False)
    piv=metrics[metrics.alpha.eq(.75)].pivot(index='base_seed',columns='arm',values='case_macro_mean'); delta=piv.reset_index(); delta['delta_E_minus_D']=delta.E-delta.D; delta.to_csv(sdir/'temporal_delta_by_seed.csv',index=False)
    bm=by.pivot_table(index=['base_seed','case_id'],columns='arm',values='mean').reset_index(); bm['delta_E_minus_D']=bm.E-bm.D; bm.to_csv(sdir/'case_seed_matrix.csv',index=False)
    decision={'oof_E_wins':int((delta.delta_E_minus_D<0).sum()),'oof_E_losses':int((delta.delta_E_minus_D>0).sum()),'mean_improvement_px':float(-delta.delta_E_minus_D.mean()),'D_sd':float(delta.D.std(ddof=1)),'E_sd':float(delta.E.std(ddof=1)),'persistent_E_better_seeds':int(sum(pers[pers.arm=='E'].set_index('base_seed').persistent_frames_ge3 < pers[pers.arm=='D'].set_index('base_seed').persistent_frames_ge3)),'val_read':False,'test_used':False}
    (sdir/'oof_decision.json').write_text(json.dumps(decision,indent=2),encoding='utf-8'); log(f"[OOF frozen] E wins {decision['oof_E_wins']}/5, mean improvement={decision['mean_improvement_px']:.3f}px")
    # Full-train models and frozen Val.
    VP={'D':[],'E':[]}; vm=[]; vb=[]
    for seed in cfg['seeds']:
        for arm in ['D','E']:
            tr=np.arange(len(dsets[arm])); x,_=run_model(p5,dsets[arm],tr,np.arange(len(DVAL[arm])),arm,seed,0,physical,accum,device,sdir/f'runs/final/seed_{seed}/arm_{arm}',cfg,log) if False else (None,None)
        # Use explicit train dataset / val dataset pair.
        predarms={}
        for arm in ['D','E']:
            rdir=sdir/f'runs/final/seed_{seed}/arm_{arm}'; train_ds=dsets[arm]; val_ds=DVAL[arm]
            done=rdir/'complete.json'; rh=hashlib.sha256(json.dumps({'cfg':cfg,'arm':arm,'seed':seed,'fold':0,'train_n':len(train_ds),'eval_n':len(val_ds)},sort_keys=True).encode()).hexdigest()
            if done.exists() and (rdir/'predictions.csv').exists() and json.loads(done.read_text()).get('run_hash')==rh: pred=pd.read_csv(rdir/'predictions.csv'); log(f'  [Resume] final seed={seed} arm={arm}')
            else:
                # Train on train_ds and infer on val_ds while preserving the same optimizer path.
                eff=seed; seed_all(eff); model=SharedBackboneFusion(p5).to(device); init_hash=tensor_hash(model); gen=torch.Generator().manual_seed(eff); loader=DataLoader(train_ds,batch_size=physical,shuffle=True,num_workers=0,pin_memory=True,generator=gen); opt=torch.optim.Adam(model.parameters(),lr=cfg['learning_rate']); sch=torch.optim.lr_scheduler.MultiStepLR(opt,milestones=cfg['scheduler_milestones'],gamma=cfg['scheduler_gamma']); tl=[]
                for ep in range(1,4):
                    model.train(); opt.zero_grad(set_to_none=True); total=0.; n=0
                    bar=tqdm(loader,desc=f'FINAL {arm} seed={seed} epoch {ep}/3',leave=False)
                    for bi,(xx,yy,_) in enumerate(bar):
                        xx=xx.to(device,non_blocking=True); yy=yy.to(device,non_blocking=True); loss=weighted_mse(model(xx),yy); (loss/accum).backward(); total+=float(loss)*len(xx); n+=len(xx)
                        if (bi+1)%accum==0 or bi+1==len(loader): opt.step(); opt.zero_grad(set_to_none=True)
                    sch.step(); tl.append({'epoch':ep,'train_loss':total/n,'arm':arm,'base_seed':seed})
                pred=infer(model,val_ds,np.arange(len(val_ds)),device,cfg['alpha'],physical); rdir.mkdir(parents=True,exist_ok=True); pred.to_csv(rdir/'predictions.csv',index=False); pd.DataFrame(tl).to_csv(rdir/'training_log.csv',index=False); torch.save({'model_state':model.state_dict(),'config':cfg},rdir/'checkpoint.pth'); done.write_text(json.dumps({'complete':True,'run_hash':rh,'initial_state_hash':init_hash},indent=2)); del model; torch.cuda.empty_cache()
            pred['base_seed']=seed; pred['arm']=arm; predarms[arm]=pred; VP[arm].append(pred); s,h=safety_hard(pred,arm,seed,'Val'); saf+=s; hard+=h
        m,b,p=analyze_pair(predarms['D'],predarms['E'],seed,'Val'); vm.append(m); vb.append(b); pers=pd.concat([pers,p],ignore_index=True)
    VD=pd.concat(VP['D'],ignore_index=True); VE=pd.concat(VP['E'],ignore_index=True); VD.to_csv(sdir/'val_D_all_seeds.csv',index=False); VE.to_csv(sdir/'val_E_all_seeds.csv',index=False)
    valm=pd.concat(vm,ignore_index=True); valm.to_csv(sdir/'val_metrics_by_seed.csv',index=False); vp=valm[valm.alpha.eq(.75)].pivot(index='base_seed',columns='arm',values='mean').reset_index(); vp['delta_E_minus_D']=vp.E-vp.D; vp.to_csv(sdir/'val_delta_by_seed.csv',index=False)
    dirs=delta[['base_seed','delta_E_minus_D']].merge(vp[['base_seed','delta_E_minus_D']],on='base_seed',suffixes=('_oof','_val')); dirs['oof_direction']=np.where(dirs.delta_E_minus_D_oof<0,'win','lose'); dirs['val_direction']=np.where(dirs.delta_E_minus_D_val<0,'win','lose'); dirs.to_csv(sdir/'oof_vs_val_direction.csv',index=False)
    safe=pd.DataFrame(saf); hard=pd.DataFrame(hard); safe.to_csv(sdir/'easy_case_safety.csv',index=False); hard.to_csv(sdir/'hard_case_rescue.csv',index=False); pers.to_csv(sdir/'persistent_harmful.csv',index=False)
    conf=[]
    for split,a,b in [('OOF',OD,OE),('Val',VD,VE)]:
        for arm,g in [('D',a),('E',b)]:
            for seed,sg in g.groupby('base_seed'): conf.append({'split':split,'base_seed':seed,'arm':arm,'peak_mean':sg.peak.mean(),'margin_mean':sg.margin.mean()})
    pd.DataFrame(conf).to_csv(sdir/'confidence_analysis.csv',index=False)
    plot_stage2(out,metrics,by,delta,vp,pers,safe,hard); montage(out,dsets['E'],OE[OE.base_seed.eq(cfg['stage1_seed'])],Path(cfg['phase7d_dir']))
    valwins=int((vp.delta_E_minus_D<0).sum()); reverse=int(((dirs.oof_direction=='win')&(dirs.val_direction=='lose')).sum())
    if decision['oof_E_wins']>=4 and valwins>=4: final_choice=1
    elif decision['oof_E_wins']>=3 or valwins>=3: final_choice=2
    else: final_choice=3
    final={'decision':final_choice,'decision_text':{1:'Feature fusion reliably improves temporal generalization',2:'Feature fusion has partial benefit but remains cross-case unstable',3:'Feature fusion has no reliable benefit; stop temporal architecture expansion'}[final_choice],'oof_E_wins':decision['oof_E_wins'],'oof_mean_improvement_px':decision['mean_improvement_px'],'val_E_wins':valwins,'oof_win_val_lose':reverse,'persistent_E_better_oof_seeds':decision['persistent_E_better_seeds'],'test_used':False}
    (sdir/'final_decision.json').write_text(json.dumps(final,indent=2),encoding='utf-8'); return final,delta,vp

def write_readme(out,cfg,mem,pc,stage1_dec,final=None):
    lines=['# Phase 8A — Shared-Backbone 3-Frame Feature Fusion','','Three causal frames are processed by one shared HRNet backbone. Spatial branch-0 features `[B,18,64,64]` are concatenated and fused with `Conv1x1(54→18) + ReLU` before the original heatmap head.','','## Fixed design','','- Crop: current `raw_t` centered 256×256 for all frames.','- Target: `true_tip_t` only.','- Loss: weighted MSE.','- Epochs: 3 fixed.','- Shrinkage: alpha=0.75 fixed.','- No future frames, new labels, augmentation, tuning, or Test.','',f"Physical batch: {mem['physical_batch']}; gradient accumulation: {mem['gradient_accumulation']}; effective batch: 16; AMP: false.",f"Parameters: backbone {pc['backbone']:,}, fusion {pc['fusion']:,}, head {pc['head']:,}, total {pc['total']:,}. Shared weights verified.",'','## Stage 1','',json.dumps(stage1_dec,ensure_ascii=False,indent=2)]
    if final: lines += ['','## Final frozen decision','',json.dumps(final,ensure_ascii=False,indent=2),'','Longer 5/7-frame windows should only be considered if this 3-frame feature-fusion design demonstrates stable OOF and Val value. No later phase was started.']
    else: lines += ['','Stage 1 failed; Stage 2 and Val were not run. No later phase was started.']
    (out/'README.md').write_text('\n'.join(lines),encoding='utf-8')

def main():
    global DVAL
    ap=argparse.ArgumentParser(); ap.add_argument('--config',required=True); args=ap.parse_args(); cfg=json.loads(Path(args.config).read_text(encoding='utf-8')); out=ROOT/cfg['output_dir']; out.mkdir(parents=True,exist_ok=True); log=Logger(out/'phase8a_run.log')
    (out/'config.json').write_text(json.dumps(cfg,indent=2),encoding='utf-8')
    log('='*52); log('Phase 8A — SHARED-BACKBONE FEATURE FUSION'); log('='*52); log('Stage1 gate before Stage2/Val | Test FORBIDDEN')
    p7b=load_pyc('p7b',ROOT/'scripts/__pycache__/phase7b_causal_3frame_hrnet.cpython-313.pyc'); p5=p7b.load_p5(ROOT); device=torch.device('cuda'); wt=pd.read_csv(ROOT/cfg['phase7b_dir']/'train_windows.csv') if (ROOT/cfg['phase7b_dir']/'train_windows.csv').exists() else None
    # Reconstruct the exact Phase7B legal windows from the frozen frame manifest.
    manifest=pd.read_csv(ROOT/cfg['manifest']); manifest['case_code']=manifest.case_code.astype(str)
    windows=p7b.build_windows(manifest); train=windows[windows.split.eq('train')].reset_index(drop=True); val=windows[windows.split.eq('val')].reset_index(drop=True)
    base_train=p7b.WindowDataset(train,str(ROOT/cfg['phase7b_dir']/'cache/train_stacks.npy'),'temporal',cfg['sigma']); base_val=p7b.WindowDataset(val,str(ROOT/cfg['phase7b_dir']/'cache/val_stacks.npy'),'temporal',cfg['sigma'])
    if len(base_train)!=2760 or len(base_val)!=920: raise RuntimeError(f'Frozen counts mismatch train={len(base_train)} val={len(base_val)}')
    dsets={a:FusionDataset(base_train,a) for a in ['D','E']}; DVAL={a:FusionDataset(base_val,a) for a in ['D','E']}; cases=sorted(train.case_id.astype(str).unique().tolist())
    pc=audit_model(p5,out,cfg,device); physical,accum=memory_sanity(p5,dsets['E'],device,cfg,out,log); mem=json.loads((out/'memory_sanity.json').read_text())
    pd.DataFrame([{'dataset':'Train','frames':2784,'legal_targets':2760,'cases':8,'series':12},{'dataset':'Val','frames':928,'legal_targets':920,'cases':3,'series':4}]).to_csv(out/'data_integrity.csv',index=False)
    passed,D,E,met,by,pers=stage1(p5,dsets,cases,physical,accum,device,out,cfg,log); audit_paired_initialization(out); dec=json.loads((out/'stage1/stage1_decision.json').read_text())
    if not passed:
        write_readme(out,cfg,mem,pc,dec,None); (out/'run_status.json').write_text(json.dumps({'status':'complete_stage1_fail','stage2_run':False,'val_read':False,'test_used':False},indent=2)); log('[STOP] Stage1 failed. Stage2 and Val were not run.'); return
    final,delta,vp=stage2(p5,dsets,cases,physical,accum,device,out,cfg,log,(D,E,met,by,pers)); audit_paired_initialization(out); write_readme(out,cfg,mem,pc,dec,final); (out/'run_status.json').write_text(json.dumps({'status':'complete','stage2_run':True,'models_total':90,'test_used':False},indent=2)); log(f"[Done] Decision {final['decision']}: {final['decision_text']}. No next phase started.")

if __name__=='__main__': main()
